<!-- Navbar Component with Inline CSS -->
<style>
  /* ── Navbar ──────────────────────────────────────────────── */
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 70px;
    background: rgba(10, 10, 10, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    z-index: 1000;
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }

  .navbar.scrolled {
    background: rgba(10, 10, 10, 0.97);
    box-shadow: 0 4px 32px rgba(0, 0, 0, 0.5);
  }

  .navbar__inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
    height: 100%;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  /* ── Brand ─────────────────────────────────────────────── */
  .navbar__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.03em;
    text-decoration: none;
    flex-shrink: 0;
  }

  .navbar__brand-icon {
    width: 36px;
    height: 36px;
    background: linear-gradient(135deg, #a855f7, #ec4899);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }

  .navbar__brand-text {
    background: linear-gradient(135deg, #a855f7, #ec4899);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ── Desktop Navigation ─────────────────────────────────── */
  .navbar__nav {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: 1;
  }

  .navbar__link {
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: color 0.2s ease, background 0.2s ease;
    white-space: nowrap;
  }

  .navbar__link:hover,
  .navbar__link.active {
    color: rgba(255, 255, 255, 0.95);
    background: rgba(255, 255, 255, 0.06);
  }

  /* ── Search ────────────────────────────────────────────── */
  .navbar__search {
    position: relative;
    max-width: 300px;
    flex: 1;
  }

  .navbar__search-input {
    width: 100%;
    padding: 8px 16px 8px 40px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 50px;
    color: rgba(255, 255, 255, 0.9);
    font-size: 14px;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .navbar__search-input::placeholder {
    color: rgba(255, 255, 255, 0.35);
  }

  .navbar__search-input:focus {
    outline: none;
    border-color: #a855f7;
    background: rgba(255, 255, 255, 0.08);
  }

  .navbar__search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(255, 255, 255, 0.35);
    pointer-events: none;
  }

  .navbar__search-results {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    background: #1a1a1a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
    z-index: 1001;
    overflow: hidden;
    display: none;
    animation: fadeDown 0.2s ease;
  }

  .navbar__search-results.open {
    display: block;
  }

  .search-result-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    transition: background 0.2s ease;
    cursor: pointer;
  }

  .search-result-item:hover {
    background: rgba(255, 255, 255, 0.04);
  }

  .search-result-item__img {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    object-fit: cover;
    background: rgba(255, 255, 255, 0.04);
    flex-shrink: 0;
  }

  .search-result-item__name {
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
  }

  .search-result-item__type {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.4);
  }

  /* ── Actions ───────────────────────────────────────────── */
  .navbar__actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  /* ── Notification Button ────────────────────────────────── */
  .navbar__notif-btn {
    position: relative;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .navbar__notif-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.9);
    border-color: rgba(255, 255, 255, 0.12);
  }

  .navbar__notif-badge {
    position: absolute;
    top: -2px;
    right: -2px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    background: linear-gradient(135deg, #ec4899, #a855f7);
    border-radius: 50%;
    font-size: 10px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    border: 2px solid #0a0a0a;
  }

  .navbar__notif-badge.hidden {
    display: none;
  }

  /* ── User Dropdown ──────────────────────────────────────── */
  .navbar__user {
    position: relative;
  }

  .navbar__user-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px 6px 6px;
    border-radius: 50px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .navbar__user-btn:hover {
    border-color: rgba(168, 85, 247, 0.4);
    background: rgba(255, 255, 255, 0.06);
  }

  .navbar__avatar {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    object-fit: cover;
    background: linear-gradient(135deg, #a855f7, #ec4899);
    flex-shrink: 0;
  }

  .navbar__user-name {
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
  }

  .navbar__chevron {
    color: rgba(255, 255, 255, 0.3);
    transition: transform 0.3s ease;
  }

  .navbar__user.open .navbar__chevron {
    transform: rotate(180deg);
  }

  .navbar__dropdown {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    min-width: 240px;
    background: #1a1a1a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
    z-index: 1001;
    overflow: hidden;
    display: none;
    animation: fadeDown 0.2s ease;
  }

  .navbar__user.open .navbar__dropdown {
    display: block;
  }

  .navbar__dropdown-header {
    padding: 16px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .navbar__dropdown-name {
    font-weight: 600;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.95);
  }

  .navbar__dropdown-email {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.4);
    margin-top: 2px;
  }

  .navbar__dropdown-role {
    display: inline-flex;
    align-items: center;
    padding: 2px 10px;
    margin-top: 6px;
    background: linear-gradient(135deg, #a855f7, #ec4899);
    border-radius: 50px;
    font-size: 10px;
    font-weight: 700;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .navbar__dropdown-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 20px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .navbar__dropdown-item:hover {
    background: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.95);
  }

  .navbar__dropdown-item svg {
    opacity: 0.5;
    flex-shrink: 0;
  }

  .navbar__dropdown-item.danger {
    color: #ef4444;
  }

  .navbar__dropdown-item.danger:hover {
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
  }

  .navbar__dropdown-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.06);
    margin: 4px 0;
  }

  /* ── Buttons ────────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    border: none;
    cursor: pointer;
  }

  .btn-sm {
    padding: 6px 16px;
    font-size: 13px;
  }

  .btn-primary {
    background: linear-gradient(135deg, #a855f7, #ec4899);
    color: #fff;
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 24px rgba(168, 85, 247, 0.3);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  /* ── Mobile Toggle ──────────────────────────────────────── */
  .navbar__mobile-toggle {
    display: none;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .navbar__mobile-toggle:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  .navbar__hamburger {
    width: 20px;
    height: 2px;
    background: rgba(255, 255, 255, 0.6);
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  /* ── Mobile Menu ────────────────────────────────────────── */
  .navbar__mobile-menu {
    display: none;
    position: fixed;
    top: 70px;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(10, 10, 10, 0.98);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    z-index: 999;
    animation: fadeDown 0.25s ease;
    overflow-y: auto;
  }

  .navbar__mobile-menu.open {
    display: block;
  }

  .navbar__mobile-menu-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 24px;
  }

  .navbar__mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .navbar__mobile-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 10px;
    font-size: 16px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .navbar__mobile-link:hover {
    background: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.95);
  }

  .navbar__mobile-link svg {
    opacity: 0.5;
    flex-shrink: 0;
  }

  .navbar__mobile-link.btn-login {
    color: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.08);
    justify-content: center;
  }

  .navbar__mobile-link.btn-register {
    background: linear-gradient(135deg, #a855f7, #ec4899);
    color: #fff;
    justify-content: center;
  }

  .navbar__mobile-link.btn-register:hover {
    box-shadow: 0 8px 24px rgba(168, 85, 247, 0.3);
  }

  .navbar__mobile-link.btn-logout {
    color: #ef4444;
  }

  .navbar__mobile-link.btn-logout:hover {
    background: rgba(239, 68, 68, 0.08);
  }

  .navbar__mobile-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.06);
    margin: 8px 0;
  }

  /* ── Animations ─────────────────────────────────────────── */
  @keyframes fadeDown {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── Hamburger to X Animation ──────────────────────────── */
  .navbar__mobile-toggle.open .navbar__hamburger:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
    background: rgba(255, 255, 255, 0.9);
  }

  .navbar__mobile-toggle.open .navbar__hamburger:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .navbar__mobile-toggle.open .navbar__hamburger:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
    background: rgba(255, 255, 255, 0.9);
  }

  /* ── Responsive Breakpoints ────────────────────────────── */

  /* Tablet */
  @media (max-width: 1024px) {
    .navbar__search {
      max-width: 200px;
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .navbar__inner {
      padding: 0 16px;
      gap: 16px;
    }

    .navbar__nav,
    .navbar__search {
      display: none;
    }

    .navbar__mobile-toggle {
      display: flex;
      margin-left: auto;
    }

    .navbar__user-name {
      display: none;
    }

    .navbar__actions {
      margin-left: 0;
    }

    .navbar__notif-btn {
      width: 38px;
      height: 38px;
    }

    .navbar__brand-text {
      font-size: 18px;
    }

    .navbar__brand-icon {
      width: 32px;
      height: 32px;
      font-size: 16px;
    }

    .btn-sm {
      padding: 6px 14px;
      font-size: 12px;
    }

    .navbar__dropdown {
      right: -60px;
      min-width: 280px;
    }
  }

  /* Small Mobile */
  @media (max-width: 480px) {
    .navbar__inner {
      padding: 0 12px;
      gap: 12px;
    }

    .navbar__brand-text {
      font-size: 16px;
    }

    .navbar__brand-icon {
      width: 28px;
      height: 28px;
      font-size: 14px;
    }

    .navbar__mobile-toggle {
      width: 36px;
      height: 36px;
    }

    .navbar__hamburger {
      width: 18px;
      height: 2px;
    }

    .navbar__notif-btn {
      width: 34px;
      height: 34px;
    }

    .navbar__notif-btn svg {
      width: 18px;
      height: 18px;
    }

    .navbar__user-btn {
      padding: 4px 8px 4px 4px;
    }

    .navbar__avatar {
      width: 26px;
      height: 26px;
    }

    .btn-sm {
      padding: 4px 12px;
      font-size: 11px;
    }

    .navbar__dropdown {
      right: -40px;
      min-width: 260px;
    }

    .navbar__mobile-menu-inner {
      padding: 16px;
    }

    .navbar__mobile-link {
      padding: 12px 14px;
      font-size: 15px;
    }
  }

  /* ── Scroll State ───────────────────────────────────────── */
  .navbar.scrolled .navbar__mobile-menu {
    top: 68px;
  }
</style>

<!-- Navbar HTML -->
<nav class="navbar" id="navbar">
  <div class="navbar__inner">

    <!-- Brand -->
    <a href="/" class="navbar__brand">
      <div class="navbar__brand-icon">⭐</div>
      <span class="navbar__brand-text">StarPass</span>
    </a>

    <!-- Desktop Nav -->
    <nav class="navbar__nav">
      <a href="/celebrities" class="navbar__link <%= currentPath.startsWith('/celebrities') ? 'active' : '' %>">Celebrities</a>
      <a href="/events" class="navbar__link <%= currentPath.startsWith('/events') ? 'active' : '' %>">Events</a>
      <a href="/fan-clubs" class="navbar__link <%= currentPath.startsWith('/fan-clubs') ? 'active' : '' %>">Fan Clubs</a>
      <a href="/about" class="navbar__link <%= currentPath === '/about' ? 'active' : '' %>">About</a>
    </nav>

    <!-- Search -->
    <div class="navbar__search" id="navSearch">
      <span class="navbar__search-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </span>
      <input type="text" class="navbar__search-input" placeholder="Search celebrities & events…" id="searchInput" autocomplete="off">
      <div class="navbar__search-results" id="searchResults"></div>
    </div>

    <!-- Actions -->
    <div class="navbar__actions">

      <% if (currentUser) { %>

        <!-- Notification Bell -->
        <a href="/fan/notifications" class="navbar__notif-btn" id="notifBtn" title="Notifications">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
          </svg>
          <span class="navbar__notif-badge hidden" id="notifBadge">0</span>
        </a>

        <!-- User Dropdown -->
        <div class="navbar__user" id="userDropdown">
          <button class="navbar__user-btn" id="userBtn">
            <img
              src="<%= currentUser.avatar?.url || '/images/defaults/avatar.png' %>"
              alt="<%= currentUser.firstName %>"
              class="navbar__avatar"
              onerror="this.src='/images/defaults/avatar.png'"
            >
            <span class="navbar__user-name"><%= currentUser.firstName %></span>
            <svg class="navbar__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>

          <div class="navbar__dropdown">
            <div class="navbar__dropdown-header">
              <div class="navbar__dropdown-name"><%= currentUser.fullName || currentUser.firstName + ' ' + currentUser.lastName %></div>
              <div class="navbar__dropdown-email"><%= currentUser.email %></div>
              <span class="navbar__dropdown-role"><%= currentUser.role.replace('_', ' ') %></span>
            </div>

            <% if (['fan'].includes(currentUser.role)) { %>
              <a href="/fan/dashboard" class="navbar__dropdown-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                Dashboard
              </a>
              <a href="/fan/tickets" class="navbar__dropdown-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                My Tickets
              </a>
              <a href="/fan/payments" class="navbar__dropdown-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                Payments
              </a>
              <a href="/fan/fan-clubs" class="navbar__dropdown-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                Fan Clubs
              </a>
              <a href="/fan/profile" class="navbar__dropdown-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                Profile
              </a>
            <% } %>

            <% if (['celebrity','celebrity_manager','event_organizer'].includes(currentUser.role)) { %>
              <a href="/celebrity/dashboard" class="navbar__dropdown-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                Dashboard
              </a>
              <a href="/celebrity/events" class="navbar__dropdown-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                My Events
              </a>
              <a href="/celebrity/fan-club" class="navbar__dropdown-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                Fan Club
              </a>
              <a href="/celebrity/analytics" class="navbar__dropdown-item">
