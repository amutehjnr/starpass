<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <meta name="csrf-token" content="<%= csrfToken %>">
</head>
<body>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<div class="dashboard-layout">
  <%- include('../partials/sidebar') %>
  <main class="dashboard-content">

    <div class="page-header flex-between">
      <div>
        <a href="/admin/celebrities/<%= celebrity._id %>" class="btn btn-ghost btn-sm mb-3">← Back to Profile</a>
        <h1 class="page-title">Edit: <%= celebrity.stageName %></h1>
      </div>
      <span class="badge badge-<%= celebrity.isVerified ? 'success' : 'warning' %>">
        <%= celebrity.isVerified ? 'Verified' : 'Unverified' %>
      </span>
    </div>

    <form action="/admin/celebrities/<%= celebrity._id %>/edit" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="grid-2 gap-6">
        <div>
          <!-- Account -->
          <div class="content-block mb-5">
            <h3 style="font-size:var(--text-base);margin-bottom:var(--space-5);">👤 Account Details</h3>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">First Name</label>
                <input type="text" name="firstName" class="form-input" value="<%= celebrity.user?.firstName || '' %>" maxlength="50">
              </div>
              <div class="form-group">
                <label class="form-label">Last Name</label>
                <input type="text" name="lastName" class="form-input" value="<%= celebrity.user?.lastName || '' %>" maxlength="50">
              </div>
            </div>
            <div class="form-group" style="margin-bottom:0;">
              <label class="form-label">Email</label>
              <input type="email" class="form-input" value="<%= celebrity.user?.email || '' %>" disabled style="opacity:0.6;">
              <div class="form-hint">Email cannot be changed here.</div>
            </div>
          </div>

          <!-- Profile -->
          <div class="content-block mb-5">
            <h3 style="font-size:var(--text-base);margin-bottom:var(--space-5);">⭐ Celebrity Profile</h3>
            <div class="form-group">
              <label class="form-label">Stage Name <span class="required">*</span></label>
              <input type="text" name="stageName" class="form-input" value="<%= celebrity.stageName %>" required maxlength="100">
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Category <span class="required">*</span></label>
                <select name="category" class="form-select" required>
                  <% ['actor','musician','athlete','comedian','influencer','model','gamer','chef','author','other'].forEach(cat => { %>
                  <option value="<%= cat %>" <%= celebrity.category === cat ? 'selected' : '' %>><%= cat.charAt(0).toUpperCase() + cat.slice(1) %></option>
                  <% }) %>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label">Base Price (USD)</label>
                <div class="input-group">
                  <span class="input-group-prefix">$</span>
                  <input type="number" name="basePrice" class="form-input" min="0" step="0.01" value="<%= celebrity.basePrice || 0 %>">
                </div>
              </div>
            </div>
            <div class="form-group">
              <label class="form-label">Short Bio</label>
              <input type="text" name="shortBio" class="form-input" value="<%= celebrity.shortBio || '' %>" maxlength="300">
            </div>
            <div class="form-group">
              <label class="form-label">Full Biography</label>
              <textarea name="biography" class="form-textarea" rows="6" maxlength="5000"><%= celebrity.biography || '' %></textarea>
            </div>
            <div class="form-group">
              <label class="form-label">Achievements</label>
              <textarea name="achievements" class="form-textarea" rows="4" placeholder="One per line"><%= (celebrity.achievements || []).join('\n') %></textarea>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Tags</label>
                <input type="text" name="tags" class="form-input" value="<%= (celebrity.tags || []).join(', ') %>">
              </div>
              <div class="form-group">
                <label class="form-label">Nationality</label>
                <input type="text" name="nationality" class="form-input" value="<%= celebrity.metadata?.nationality || '' %>">
              </div>
            </div>
            <div class="form-group" style="margin-bottom:0;">
              <label class="form-label">Genres</label>
              <input type="text" name="genres" class="form-input" value="<%= (celebrity.metadata?.genres || []).join(', ') %>">
            </div>
          </div>
        </div>

        <div>
          <!-- Images -->
          <div class="content-block mb-5">
            <h3 style="font-size:var(--text-base);margin-bottom:var(--space-5);">📷 Images</h3>
            <% if (celebrity.profileImage?.url) { %>
            <img src="<%= celebrity.profileImage.url %>" style="width:80px;height:80px;border-radius:50%;object-fit:cover;margin-bottom:var(--space-3);">
            <% } %>
            <div class="form-group">
              <label class="form-label">Replace Profile Photo</label>
              <div class="upload-zone">
                <input type="file" name="profileImage" accept="image/*" class="upload-zone__input">
                <div style="font-size:24px;margin-bottom:var(--space-2);">📷</div>
                <div class="upload-zone__title">Upload New Photo</div>
                <img class="upload-zone__preview" style="display:none;max-height:120px;">
              </div>
            </div>
            <% if (celebrity.heroImage?.url) { %>
            <img src="<%= celebrity.heroImage.url %>" style="width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:var(--radius-md);margin-bottom:var(--space-3);">
            <% } %>
            <div class="form-group" style="margin-bottom:0;">
              <label class="form-label">Replace Hero Banner</label>
              <div class="upload-zone">
                <input type="file" name="heroImage" accept="image/*" class="upload-zone__input">
                <div style="font-size:24px;margin-bottom:var(--space-2);">🖼️</div>
                <div class="upload-zone__title">Upload New Banner</div>
                <img class="upload-zone__preview" style="display:none;max-height:120px;">
              </div>
            </div>
          </div>

          <!-- Settings -->
          <div class="content-block mb-5">
            <h3 style="font-size:var(--text-base);margin-bottom:var(--space-5);">⚙️ Settings</h3>
            <div class="form-group">
              <label class="form-check">
                <input type="checkbox" name="isVerified" class="form-check-input" <%= celebrity.isVerified ? 'checked' : '' %>>
                <span class="form-check-label">Verified</span>
              </label>
            </div>
            <div class="form-group" style="margin-bottom:0;">
              <label class="form-check">
                <input type="checkbox" name="isFeatured" class="form-check-input" <%= celebrity.isFeatured ? 'checked' : '' %>>
                <span class="form-check-label">Featured on homepage</span>
              </label>
            </div>
          </div>

          <button type="submit" class="btn btn-primary btn-full btn-lg">Save Changes</button>
        </div>
      </div>
    </form>

    <!-- Danger Zone -->
    <div class="content-block mt-8" style="border-color:rgba(239,68,68,0.3);">
      <h3 style="font-size:var(--text-base);margin-bottom:var(--space-5);color:var(--color-error);">⚠️ Danger Zone</h3>
      <div style="display:flex;gap:var(--space-4);flex-wrap:wrap;">
        <form action="/admin/celebrities/<%= celebrity._id %>/suspend" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-warning" style="background:var(--color-warning);color:#000;" onclick="return confirm('<%= celebrity.isActive ? 'Suspend this celebrity? All their events will be postponed.' : 'Reinstate this celebrity?' %>')">
            <%= celebrity.isActive ? '⏸️ Suspend Celebrity' : '▶️ Reinstate Celebrity' %>
          </button>
        </form>
        <% if (currentUser.role === 'super_admin') { %>
        <form action="/admin/celebrities/<%= celebrity._id %>/delete" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-danger" onclick="return confirm('PERMANENTLY delete <%= celebrity.stageName %>? This cannot be undone. All events will be cancelled.')">
            🗑️ Delete Celebrity
          </button>
        </form>
        <% } %>
      </div>
    </div>

  </main>
</div>

<%- include('../partials/footer') %>
<script src="/js/app.js"></script>
<script src="/js/dashboard.js"></script>
</body>
</html>