<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <meta name="csrf-token" content="<%= csrfToken %>">
</head>
<body>
<%- include('../../partials/navbar') %>
<%- include('../../partials/flash') %>

<div class="dashboard-layout">
  <%- include('../../partials/sidebar') %>
  <main class="dashboard-content">

    <div class="page-header">
      <a href="/admin/celebrities" class="btn btn-ghost btn-sm mb-3">← Back to Celebrities</a>
      <h1 class="page-title">Create Celebrity</h1>
      <p class="page-subtitle">Add a new celebrity directly to the platform</p>
    </div>

    <form action="/admin/celebrities/create" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="grid-2 gap-6">
        <div>
          <!-- Account -->
          <div class="content-block mb-5">
            <h3 style="font-size:var(--text-base);margin-bottom:var(--space-5);">👤 Account Details</h3>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">First Name <span class="required">*</span></label>
                <input type="text" name="firstName" class="form-input" required maxlength="50">
              </div>
              <div class="form-group">
                <label class="form-label">Last Name <span class="required">*</span></label>
                <input type="text" name="lastName" class="form-input" required maxlength="50">
              </div>
            </div>
            <div class="form-group">
              <label class="form-label">Email <span class="required">*</span></label>
              <input type="email" name="email" class="form-input" required>
            </div>
            <div class="form-group" style="margin-bottom:0;">
              <label class="form-label">Password</label>
              <input type="text" name="password" class="form-input" placeholder="Leave blank to auto-generate">
              <div class="form-hint">A random password will be generated if left blank. Send the celebrity their credentials separately.</div>
            </div>
          </div>

          <!-- Profile -->
          <div class="content-block mb-5">
            <h3 style="font-size:var(--text-base);margin-bottom:var(--space-5);">⭐ Celebrity Profile</h3>
            <div class="form-group">
              <label class="form-label">Stage Name <span class="required">*</span></label>
              <input type="text" name="stageName" class="form-input" required maxlength="100">
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Category <span class="required">*</span></label>
                <select name="category" class="form-select" required>
                  <% ['actor','musician','athlete','comedian','influencer','model','gamer','chef','author','other'].forEach(cat => { %>
                  <option value="<%= cat %>"><%= cat.charAt(0).toUpperCase() + cat.slice(1) %></option>
                  <% }) %>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label">Base Price (USD)</label>
                <div class="input-group">
                  <span class="input-group-prefix">$</span>
                  <input type="number" name="basePrice" class="form-input" min="0" step="0.01" value="0">
                </div>
              </div>
            </div>
            <div class="form-group">
              <label class="form-label">Short Bio</label>
              <input type="text" name="shortBio" class="form-input" maxlength="300" placeholder="One-line tagline">
            </div>
            <div class="form-group">
              <label class="form-label">Full Biography</label>
              <textarea name="biography" class="form-textarea" rows="6" maxlength="5000"></textarea>
            </div>
            <div class="form-group">
              <label class="form-label">Achievements</label>
              <textarea name="achievements" class="form-textarea" rows="4" placeholder="One achievement per line"></textarea>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Tags</label>
                <input type="text" name="tags" class="form-input" placeholder="pop, music, performer">
                <div class="form-hint">Comma-separated</div>
              </div>
              <div class="form-group">
                <label class="form-label">Nationality</label>
                <input type="text" name="nationality" class="form-input" placeholder="American">
              </div>
            </div>
            <div class="form-group" style="margin-bottom:0;">
              <label class="form-label">Genres</label>
              <input type="text" name="genres" class="form-input" placeholder="Pop, R&B, Funk">
              <div class="form-hint">Comma-separated</div>
            </div>
          </div>
        </div>

        <div>
          <!-- Images -->
          <div class="content-block mb-5">
            <h3 style="font-size:var(--text-base);margin-bottom:var(--space-5);">📷 Images</h3>
            <div class="form-group">
              <label class="form-label">Profile Photo</label>
              <div class="upload-zone">
                <input type="file" name="profileImage" accept="image/*" class="upload-zone__input">
                <div style="font-size:32px;margin-bottom:var(--space-2);">📷</div>
                <div class="upload-zone__title">Upload Profile Photo</div>
                <img class="upload-zone__preview" style="display:none;max-height:160px;">
              </div>
            </div>
            <div class="form-group" style="margin-bottom:0;">
              <label class="form-label">Hero Banner</label>
              <div class="upload-zone">
                <input type="file" name="heroImage" accept="image/*" class="upload-zone__input">
                <div style="font-size:32px;margin-bottom:var(--space-2);">🖼️</div>
                <div class="upload-zone__title">Upload Hero Banner</div>
                <img class="upload-zone__preview" style="display:none;max-height:160px;">
              </div>
            </div>
          </div>

          <!-- Flags -->
          <div class="content-block">
            <h3 style="font-size:var(--text-base);margin-bottom:var(--space-5);">⚙️ Settings</h3>
            <div class="form-group">
              <label class="form-check">
                <input type="checkbox" name="isVerified" class="form-check-input" checked>
                <span class="form-check-label">Mark as Verified immediately</span>
              </label>
            </div>
            <div class="form-group" style="margin-bottom:0;">
              <label class="form-check">
                <input type="checkbox" name="isFeatured" class="form-check-input">
                <span class="form-check-label">Feature on homepage</span>
              </label>
            </div>
          </div>

          <button type="submit" class="btn btn-primary btn-full btn-lg mt-6">Create Celebrity</button>
        </div>
      </div>
    </form>

  </main>
</div>

<%- include('../../partials/footer') %>
<script src="/js/app.js"></script>
<script src="/js/dashboard.js"></script>
</body>
</html>